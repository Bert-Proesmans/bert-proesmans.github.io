---
layout: base
schema: BlogPosting
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    <h1 class="gradient-text">{{ title }}</h1>

    {% if image %}
      <!-- image -->
      {%
        imageKeys {
          "src": image,
          "alt": alt or "",
          "credit": credit,
          "loading": "eager",
          "containerClass": "feature"
        }
      %}
    {% endif %}

    <p class="meta | cluster gutter-xs-s">
      <!-- draft status -->
      {%- if draft -%}
        <span class="button" data-small-button data-button-variant="tertiary">draft</span>
      {%- endif %}
      <!-- date -->
      {% if updated %}
        {% set definedDate = updated %}
        {% include "partials/date.njk" %}
        {# WARN; Issue here with character spacing next to 'time' element, there is a space that won't dissapear whatever I do.. #}
        <span style="--gutter:0">( 
          {% set definedDate = date %}
          {% include "partials/date.njk" -%})</span>
      {% else %}
        {% set definedDate = date %}
        {% include "partials/date.njk" -%}
      {% endif %}
      {%
        if tags.length >
        1
      %}
        <!-- tags -->
        {% for tag in tags %}{% if tag != "posts" %}
          <a class="button" href="/tags/{{ tag | slugify }}/" data-small-button> {{ tag }} </a>
        {% endif %}{% endfor %}
      {% endif %}
    </p>

    {{ content | safe }}
    {% include 'partials/edit-on.njk' %}
  </div>

  <!--  h-card infos: https://indieweb.org/authorship -->
  <div hidden class="h-entry">
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.url) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.url) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</div>

<!--
<div class="container-top">
  <a href="#top" aria-label="Back to top of page"></a>
  <span class="label">back to top</span>
</div>
-->

{%- if no_back_to_top != true -%}
  <custom-back-to-top></custom-back-to-top>
{%- endif %}

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
{%- endcss -%}

<style webc:scoped>
:host {
  --size: 3rem;
  --offset: 2rem;
  
  position: fixed;
  bottom: var(--offset);
  right: var(--offset);
  
  /* Scroll-driven animation: fades in after 300px of scroll */
  animation: fadeInOnScroll linear forwards;
  animation-timeline: scroll(root);
  animation-range: 0 300px;
}

@keyframes fadeInOnScroll {
  from {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  to {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}

.wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
}

a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size);
  height: var(--size);
  border-radius: 0.5rem;
  background-color: var(--color-primary);
  color: var(--color-bg);
  text-decoration: none;
  font-weight: 700;
  font-size: 1.5rem;
  line-height: 1;
  border: 2px solid var(--color-primary);
  transition: background-color var(--transition-duration) var(--transition-timing),
              color var(--transition-duration) var(--transition-timing);
  position: relative;
  cursor: pointer;
  flex-shrink: 0;
  /* z-index: 1; */
}

a:hover {
  background-color: transparent;
  color: var(--color-primary);
}

a:active {
  transform: scale(0.95);
}

/* Arrow icon - stays centered */
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Sliding text on hover - appears to the LEFT of the button */
.label {
  position: absolute;
  right: calc(var(--size) + 0.5rem);
  top: 50%;
  transform: translateY(-50%) translateX(-0.5rem);
  white-space: nowrap;
  font-size: 0.875rem;
  opacity: 0;
  transition: opacity var(--transition-duration) var(--transition-timing),
              transform var(--transition-duration) var(--transition-timing);
  pointer-events: none;
}

a:hover ~ .label {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

/* Focus styles for accessibility */
a:focus-visible {
  outline: 2px solid var(--color-text);
  outline-offset: 2px;
}

/* Responsive sizing */
/*
@media (max-width: 40em) {
  :host {
    --size: 2.5rem;
    --offset: 1rem;
  }
  
  .label {
    display: none;
  }
}
*/
</style>

<div class="wrapper">
  <a href="#top" aria-label="Back to top of page">
    <span class="icon">↑</span>
  </a>
  <span class="label">back to top</span>
</div>
